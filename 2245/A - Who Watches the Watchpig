import sys
 
 
def solve() -> None:
  data = sys.stdin.read().split()
  if not data:
    return
 
  t = int(data[0])
  idx = 1
  out = []
 
  for _ in range(t):
    n = int(data[idx])
    k = int(data[idx + 1])
    s = data[idx + 2]
    idx += 3
 
    if 2 * k > n:
      out.append("-1")
      continue
 
    flips = 0
    for i in range(k):
      if s[i] != "R":
        flips += 1
    for i in range(n - k, n):
      if s[i] != "L":
        flips += 1
 
    out.append(str(flips))
 
  sys.stdout.write("
".join(out) + "
")
 
 
if __name__ == "__main__":
  solve()